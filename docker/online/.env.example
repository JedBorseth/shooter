# Copy to .env next to compose.yml and replace every value before the stack
# faces the internet. Generate secrets with: openssl rand -hex 24
POSTGRES_PASSWORD=
# Public: the game sends it (Options, Online). Change it to stop old clients
# signing in.
NAKAMA_SERVER_KEY=defaultkey
# Secret: dedicated servers use it for the server-only RPCs.
NAKAMA_HTTP_KEY=
NAKAMA_SESSION_KEY=
NAKAMA_REFRESH_KEY=
NAKAMA_CONSOLE_USER=admin
NAKAMA_CONSOLE_PASSWORD=
NAKAMA_CONSOLE_KEY=
# Secret: Nakama's match handler calls the allocator with it.
ALLOCATOR_KEY=
# The address players connect to for matchmade servers.
PUBLIC_HOST=
# Dedicated server image for matches; pin a build to match your players'.
SHOOTER_SERVER_IMAGE=ghcr.io/jedborseth/shooter-server:nightly
