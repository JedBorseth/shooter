[Unit]
Description=Shooter with Nuketown on the remote desktop
After=default.target

[Service]
Type=simple
Environment=SHOOTER_RESERVE_GPU=1
WorkingDirectory=%h/games/shooter-nuketown
ExecStart=%h/games/shooter-nuketown/tools/run_on_borseth.sh
ExecStopPost=%h/games/shooter-nuketown/tools/restore_borseth_gpu.sh
TimeoutStopSec=45

[Install]
WantedBy=default.target
