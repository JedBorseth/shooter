[Unit]
Description=Shooter private crash inbox on the public host
After=network.target

[Service]
ExecStart=/usr/bin/python3 %h/.local/share/shooter-crashes/crash_receiver.py --dir %h/.local/share/shooter-crashes/reports
Restart=on-failure
NoNewPrivileges=true
PrivateTmp=true
UMask=0077

[Install]
WantedBy=default.target
