# Normalize text files to LF (Godot's default).
* text=auto eol=lf

# Binary assets go through Git LFS, so clones and history stay small as art and audio grow.
# Models
*.fbx filter=lfs diff=lfs merge=lfs -text
*.glb filter=lfs diff=lfs merge=lfs -text
*.blend filter=lfs diff=lfs merge=lfs -text
*.obj filter=lfs diff=lfs merge=lfs -text
# Textures and images
*.png filter=lfs diff=lfs merge=lfs -text
*.jpg filter=lfs diff=lfs merge=lfs -text
*.jpeg filter=lfs diff=lfs merge=lfs -text
*.webp filter=lfs diff=lfs merge=lfs -text
*.tga filter=lfs diff=lfs merge=lfs -text
*.exr filter=lfs diff=lfs merge=lfs -text
*.hdr filter=lfs diff=lfs merge=lfs -text
*.psd filter=lfs diff=lfs merge=lfs -text
*.ktx2 filter=lfs diff=lfs merge=lfs -text
# Audio
*.ogg filter=lfs diff=lfs merge=lfs -text
*.wav filter=lfs diff=lfs merge=lfs -text
*.mp3 filter=lfs diff=lfs merge=lfs -text
# Fonts and video
*.ttf filter=lfs diff=lfs merge=lfs -text
*.otf filter=lfs diff=lfs merge=lfs -text
*.ogv filter=lfs diff=lfs merge=lfs -text

# Ready-to-play Nuketown resources; PNG textures use the image rule above.
godot/assets/maps/nuketown/generated/*.bin filter=lfs diff=lfs merge=lfs -text
# Lightmap UV caches: committed so every machine gets the UVs the baked lightmaps were made for.
*.unwrap_cache filter=lfs diff=lfs merge=lfs -text
# Prop geometry from tools/build_props.py.
godot/assets/props/*/*.bin filter=lfs diff=lfs merge=lfs -text
godot/assets/maps/nuketown/generated/*.gltf filter=lfs diff=lfs merge=lfs -text
godot/assets/maps/nuketown/generated/*.scn filter=lfs diff=lfs merge=lfs -text

# Interactive Nuketown model geometry.
godot/assets/maps/nuketown/props/models/*.bin filter=lfs diff=lfs merge=lfs -text

# Slamcity's meshes from tools/build_slamcity_city.py.
godot/assets/maps/slamcity/*.bin filter=lfs diff=lfs merge=lfs -text
godot/assets/maps/slamcity/*.gltf filter=lfs diff=lfs merge=lfs -text
