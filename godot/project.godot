[layer_names]

3d_physics/layer_1="world"
3d_physics/layer_2="players"
3d_physics/layer_3="hitboxes"
3d_physics/layer_4="interactables"
3d_physics/layer_5="bodies"
3d_physics/layer_6="barriers"
3d_physics/layer_7="player_blockers"
3d_physics/layer_8="ragdoll"
3d_physics/layer_9="ladders"

[physics]

common/physics_ticks_per_second=120
3d/physics_engine="Jolt Physics"
jolt_physics_3d/queries/enable_ray_cast_face_index=true

[rendering]

textures/vram_compression/import_etc2_astc=true
anti_aliasing/quality/msaa_3d=2
environment/defaults/default_clear_color=Color(0.035, 0.05, 0.08, 1)
anti_aliasing/quality/screen_space_aa=2
occlusion_culling/use_occlusion_culling=true

[shader_globals]

viewmodel_key={
"type": "vec4",
"value": Vector4(0, 1, 0, 0)
}
viewmodel_key_color={
"type": "color",
"value": Color(1, 1, 1, 1)
}
viewmodel_scope_lens={
"type": "vec4",
"value": Vector4(0, 0, 0, 0)
}
world_wetness={
"type": "float",
"value": 0.0
}
world_detail_normal={
"type": "sampler2D",
"value": "res://assets/textures/detail/detail_normal.tres"
}
world_noise={
"type": "sampler2D",
"value": "res://assets/textures/noise/macro.png"
}
world_wear={
"type": "sampler2D",
"value": "res://assets/textures/noise/wear.png"
}
