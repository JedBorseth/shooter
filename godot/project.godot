; Open this file with Godot 4.7 or newer.
; Build the Rust extension first: `cargo build` in ../rust.
config_version=5

[application]
config/name="Shooter"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://assets/icon.svg"

[autoload]

Settings="*res://scripts/settings.gd"
Net="*res://scripts/net/bootstrap.gd"

[display]
window/size/viewport_width=1600
window/size/viewport_height=900
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/vsync/vsync_mode=2

[input]
move_forward={
"deadzone": 0.12,
"events": [Object(InputEventKey,"physical_keycode":87), Object(InputEventJoypadMotion,"device":-1,"axis":1,"axis_value":-1.0)]
}
move_back={
"deadzone": 0.12,
"events": [Object(InputEventKey,"physical_keycode":83), Object(InputEventJoypadMotion,"device":-1,"axis":1,"axis_value":1.0)]
}
move_left={
"deadzone": 0.12,
"events": [Object(InputEventKey,"physical_keycode":65), Object(InputEventJoypadMotion,"device":-1,"axis":0,"axis_value":-1.0)]
}
move_right={
"deadzone": 0.12,
"events": [Object(InputEventKey,"physical_keycode":68), Object(InputEventJoypadMotion,"device":-1,"axis":0,"axis_value":1.0)]
}
jump={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":32), Object(InputEventJoypadButton,"device":-1,"button_index":0,"pressed":true)]
}
sprint={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":4194325), Object(InputEventJoypadButton,"device":-1,"button_index":7,"pressed":true)]
}
crouch={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":67), Object(InputEventKey,"physical_keycode":4194326), Object(InputEventJoypadButton,"device":-1,"button_index":1,"pressed":true)]
}
fire={
"deadzone": 0.25,
"events": [Object(InputEventMouseButton,"button_index":1), Object(InputEventJoypadMotion,"device":-1,"axis":5,"axis_value":1.0)]
}
aim={
"deadzone": 0.25,
"events": [Object(InputEventMouseButton,"button_index":2), Object(InputEventJoypadMotion,"device":-1,"axis":4,"axis_value":1.0)]
}
reload={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":82), Object(InputEventJoypadButton,"device":-1,"button_index":2,"pressed":true)]
}
weapon_next={
"deadzone": 0.2,
"events": [Object(InputEventMouseButton,"button_index":4), Object(InputEventMouseButton,"button_index":5), Object(InputEventJoypadButton,"device":-1,"button_index":3,"pressed":true)]
}
weapon_1={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":49)]
}
weapon_2={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":50)]
}
interact={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":70)]
}
look_left={
"deadzone": 0.1,
"events": [Object(InputEventJoypadMotion,"device":-1,"axis":2,"axis_value":-1.0)]
}
look_right={
"deadzone": 0.1,
"events": [Object(InputEventJoypadMotion,"device":-1,"axis":2,"axis_value":1.0)]
}
look_up={
"deadzone": 0.1,
"events": [Object(InputEventJoypadMotion,"device":-1,"axis":3,"axis_value":-1.0)]
}
look_down={
"deadzone": 0.1,
"events": [Object(InputEventJoypadMotion,"device":-1,"axis":3,"axis_value":1.0)]
}
pause={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":4194305)]
}
toggle_controls={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":4194332)]
}
refill_ammo={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":84)]
}

[layer_names]
3d_physics/layer_1="world"
3d_physics/layer_2="players"
3d_physics/layer_3="hitboxes"
3d_physics/layer_4="interactables"

[physics]
3d/physics_engine="Jolt Physics"
common/physics_ticks_per_second=120

[rendering]
anti_aliasing/quality/msaa_3d=2
anti_aliasing/quality/screen_space_aa=2
environment/defaults/default_clear_color=Color(0.035, 0.05, 0.08, 1)
textures/vram_compression/import_etc2_astc=true
