// LSW-6 light support weapon: a 75-round magazine and steady sustained fire.
// Four hits kill to about 49 m (30 up close), five beyond, paid for
// with slow handling: a long aim, a slow sprint-out, a heavy step, and a long
// reload.
(
    name: "LSW-6",
    class: Lmg,
    slot: Primary,
    fire_mode: Auto,
    rounds_per_minute: 650,
    magazine: 75,
    reserve: 225,
    damage: (near: 30, far: 22, falloff_start: 30, falloff_end: 60, headshot: 1.35),
    range: 400,
    penetration: 0.45,
    reload: Magazine(time: 4.8, empty_time: 5.6, mag_in: Some(3.3)),
    ads_time: 0.42,
    sprint_out_time: 0.38,
    raise_time: 0.7,
    // First raise: Black Ops 2's for the class, scaled to our quicker draws.
    first_raise_time: 1.7,
    lower_time: 0.4,
    spread: (hip: 3.4, hip_moving: 6.0, air: 8.0, ads: 0.05, bloom: 0.2, bloom_max: 2.5, ads_sway: 0.15),
    ads_fov_scale: 0.8,
    ads_move_scale: 0.45,
    move_scale: 0.88,
    recoil: (
        pattern: [
            (0.3, 0.03), (0.32, 0.16), (0.33, 0.18), (0.32, -0.13),
            (0.31, -0.18), (0.3, 0.16), (0.3, 0.18), (0.29, -0.16),
            (0.29, -0.18), (0.28, 0.16), (0.28, 0.17), (0.28, -0.05),
        ],
        jitter: (0.05, 0.12),
        ads_scale: 0.75,
        kick_return: 0.45,
        recovery_delay: 0.02,
        recovery_rate: 20.0,
    ),
    tracer_every: 4,
    attachments: [RedDot, Acog, Suppressor, Grip, ExtendedMag],
    // The player level that unlocks it (Create-a-Class, docs/create-a-class.md).
    unlock_level: 16,
    // Hands on the model: GripRight and GripLeft in lsw6_view.tscn.
    grips: Some((right: (0, -0.1301, 0.1661), left: (0, -0.061, -0.1473), rake: 22, section: Some((centre: (0.0000, -0.0517), half: (0.0237, 0.0185))))),
    // Finger poses fitted to the model by tests/bake_hand_poses.gd:
    // curl in degrees per joint (index, middle, ring, little, thumb), each
    // finger's spread, and the hand's seat off its marker (m). Re-run it
    // after moving the grips or changing the model.
    hands: Some((
        right: (fingers: ((4.5, 16.5, 51.5), (44.5, 34, 64.5), (52, 32.5, 51.5), (75.5, 77, 44.5), (-32.5, 5, 6)), spread: Some((-4, 0, 3, 7, 46.5)), seat: (-0.006, -0.002, -0.001)),
        index_off: (4, 6, 4),
        left: (fingers: ((56, 58, 34), (62, 65, 41), (71, 73, 44.5), (81, 92.5, 55.5), (16, 36.5, 39.5)), spread: Some((-9, -2, 3, 9, 60)), seat: (0, 0, 0)),
        left_foregrip: Some((fingers: ((38.5, 40, 23.5), (73, 81.5, 64.5), (80, 85, 45), (85, 85, 45), (21.5, 43, 65.5)), spread: Some((-2, 0, 2, 4, 40)), seat: (0.012, 0.01, -0.009))),
    )),
    // Set by hand after the fit, applied over `hands` (a re-bake keeps it):
    // the support index lies straight along the handguard's side, pointing
    // forward, instead of curling over its top edge, where its tip rose
    // into the red dot's window (chosen by rendering candidates and
    // counting the hand's pixels in the window: 1151 px to none).
    // The firing thumb lies forward along the receiver's right side and
    // curls under its lower edge (fp-polish round 3): the fitted thumb
    // stood up beside the dust cover, into the aimed picture once the eye
    // sits behind the cover (`iron_eye_back`). Chosen by a search over
    // thumb poses clear of the weapon, lowest from the aimed eye.
    hand_tuning: Some((
        right: Some((fingers: (None, None, None, None, Some((-20, 40, 45))), spread: (None, None, None, None, Some(50)))),
    )),
)
