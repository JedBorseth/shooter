// SG-12 semi-automatic shotgun: eight pellets as fast as the trigger is
// pulled (450 rpm), one shot kills to about 7.5 m and two, 133 ms apart, to
// about 10 m; an eight-round box magazine, reloaded like a rifle's. Black
// Ops 2's S12: eight pellets, 30 damage to 3.75 m, 20 to 7.5 m, nothing past
// 15 m, and the fastest fire of its class (468 rpm).
(
    name: "SG-12",
    class: Shotgun,
    slot: Primary,
    fire_mode: Semi,
    rounds_per_minute: 450,
    pellets: 8,
    pellet_spread: 2.3,
    magazine: 8,
    reserve: 32,
    damage: (near: 24, far: 9, falloff_start: 5, falloff_end: 15, headshot: 1.2),
    range: 30,
    penetration: 0.08,
    reload: Magazine(time: 2.4, empty_time: 2.9, mag_in: Some(1.5)),
    ads_time: 0.26,
    sprint_out_time: 0.22,
    raise_time: 0.45,
    // First raise: Black Ops 2's for the class, scaled to our quicker draws.
    first_raise_time: 1.3,
    lower_time: 0.3,
    spread: (hip: 1.2, hip_moving: 1.7, air: 3.2, ads: 0.0, ads_sway: 0.13),
    ads_fov_scale: 0.88,
    ads_move_scale: 0.65,
    move_scale: 0.97,
    // A lighter kick than the pump's, but every pull lands it.
    recoil: (
        pattern: [(1.5, 0.15)],
        jitter: (0.22, 0.3),
        ads_scale: 0.8,
        kick_return: 0.62,
        recovery_delay: 0.04,
        recovery_rate: 16.0,
    ),
    tracer_every: 0,
    attachments: [RedDot, Suppressor, Grip, ExtendedMag],
    // The player level that unlocks it (Create-a-Class, docs/create-a-class.md).
    unlock_level: 34,
    // Hands on the model: GripRight and GripLeft in sg12_view.tscn.
    grips: Some((right: (0, -0.119, 0.131), left: (0, -0.0665, -0.288), rake: 45, section: Some((centre: (0.0000, -0.0504), half: (0.0213, 0.0187))))),
    // Finger poses fitted to the model by tests/bake_hand_poses.gd:
    // curl in degrees per joint (index, middle, ring, little, thumb), each
    // finger's spread, and the hand's seat off its marker (m). Re-run it
    // after moving the grips or changing the model.
    hands: Some((
        right: (fingers: ((60, 81, 44), (77.5, 105, 64.5), (75, 80, 45), (80, 80, 45), (-11.5, 9, 52.5)), spread: Some((-5, 0, 3, 7, 40.5)), seat: (-0.002, -0.007, -0.01)),
        index_off: (4, 6, 4),
        left: (fingers: ((22, 74.5, 55), (47.5, 74.5, 55.5), (46, 88, 55), (50, 88, 55), (-3, 12, 7)), spread: Some((-2, -1, 2, 4, 45)), seat: (-0.002, -0.002, 0)),
        left_foregrip: Some((fingers: ((38.5, 40, 23), (73, 81.5, 64.5), (80, 85, 45), (85, 85, 45), (21.5, 42.5, 65.5)), spread: Some((-2, 0, 2, 4, 40)), seat: (0.012, 0.009, -0.009))),
    )),
)
