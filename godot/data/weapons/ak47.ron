// AK-47-style rifle: slower and harder-hitting than the M4 (3-shot kill to
// about 9 m, where the SMG still wins), but it falls off further (5 hits past
// about 42 m) and its climb is heavier, hooking right then left.
(
    name: "AK-47",
    slot: Primary,
    fire_mode: Auto,
    rounds_per_minute: 600,
    magazine: 30,
    reserve: 120,
    damage: (near: 34, far: 24, falloff_start: 7, falloff_end: 45, headshot: 1.4),
    range: 400,
    penetration: 0.36,
    reload: Magazine(time: 2.4, empty_time: 2.9, mag_in: Some(1.6)),
    ads_time: 0.27,
    sprint_out_time: 0.25,
    raise_time: 0.46,
    // First raise: Black Ops 2's for the class, scaled to our quicker draws.
    first_raise_time: 1.2,
    lower_time: 0.3,
    spread: (hip: 2.5, hip_moving: 4.5, air: 6.5, ads: 0.05, bloom: 0.3, bloom_max: 2.5, ads_sway: 0.13),
    ads_fov_scale: 0.8,
    ads_move_scale: 0.58,
    move_scale: 0.97,
    recoil: (
        pattern: [
            (0.46, 0.08), (0.5, 0.4), (0.52, 0.51), (0.52, 0.48),
            (0.5, 0.35), (0.49, -0.08), (0.48, -0.4), (0.48, -0.45),
            (0.47, -0.16), (0.47, 0.29), (0.46, 0.42), (0.46, 0.22),
        ],
        jitter: (0.06, 0.15),
        ads_scale: 0.7,
        kick_return: 0.45,
        recovery_delay: 0.02,
        recovery_rate: 20.0,
    ),
    tracer_every: 3,
    attachments: [RedDot, Acog, Suppressor, Grip, ExtendedMag],
    // Hands on the model: GripRight and GripLeft in ak47_view.tscn.
    grips: Some((right: (0, -0.1305, 0.1718), left: (0, -0.0607, -0.1475), rake: 25)),
    // Finger poses fitted to the model by tests/bake_hand_poses.gd:
    // curl in degrees per joint (index, middle, ring, little, thumb), each
    // finger's spread, and the hand's seat off its marker (m). Re-run it
    // after moving the grips or changing the model.
    hands: Some((
        right: (fingers: ((10.5, 61, 51.5), (74, 79, 49.5), (76, 80, 64.5), (74, 79, 51.5), (-32.5, 4.5, 5)), spread: Some((-4, -1.5, 3, 7, 48.5)), seat: (-0.006, -0.002, -0.01)),
        index_off: (4, 6, 4),
        left: (fingers: ((-6, 9.5, 51.5), (60, 65, 38), (62, 65, 38), (65, 65, 38), (-10, -1, 3)), spread: Some((6, -1, 4, 9, 44)), seat: (0.012, -0.012, 0.003)),
        left_foregrip: Some((fingers: ((9.5, 12, 64.5), (75, 85, 45), (80, 85, 45), (85, 85, 45), (-8, 6, 6)), spread: Some((14, 0, 2, 4, 40)), seat: (0.001, -0.01, 0.006))),
    )),
)
