// AK-47-style rifle: slower and harder-hitting than the M4 (3-shot kill up
// close), with a stronger climb that pulls right.
(
    name: "AK-47",
    slot: Primary,
    fire_mode: Auto,
    rounds_per_minute: 600,
    magazine: 30,
    reserve: 120,
    damage: (near: 34, far: 25, falloff_start: 22, falloff_end: 45, headshot: 1.4),
    range: 400,
    reload: Magazine(time: 2.4, empty_time: 2.9),
    ads_time: 0.23,
    sprint_out_time: 0.19,
    raise_time: 0.4,
    lower_time: 0.26,
    spread: (hip: 2.5, hip_moving: 4.5, air: 6.5, ads: 0.05),
    ads_fov_scale: 0.8,
    ads_move_scale: 0.58,
    move_scale: 0.97,
    recoil: (
        pattern: [
            (0.49, 0.03), (0.46, 0.1), (0.42, 0.13), (0.39, 0.16),
            (0.36, 0.2), (0.33, 0.1), (0.31, -0.07), (0.3, -0.16),
            (0.29, 0.07), (0.29, 0.2), (0.29, 0.13), (0.29, 0.03),
        ],
        jitter: (0.05, 0.09),
        ads_scale: 0.7,
        recovery_delay: 0.08,
        recovery_rate: 9.0,
    ),
    tracer_every: 3,
)
