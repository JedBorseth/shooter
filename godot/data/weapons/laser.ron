// Prism Laser: the Nuketown easter egg (see godot/scripts/secret_laser.gd).
// Deliberately broken: kills anything in one hit at any range, full auto, no
// spread, no recoil, and a magazine that takes over a minute to empty.
(
    name: "PRISM LASER",
    slot: Primary,
    fire_mode: Auto,
    rounds_per_minute: 900,
    magazine: 999,
    reserve: 9999,
    damage: (near: 10000, far: 10000, falloff_start: 2000, falloff_end: 2000, headshot: 1.0),
    range: 2000,
    reload: Magazine(time: 0.6, empty_time: 0.6),
    ads_time: 0.08,
    sprint_out_time: 0.05,
    raise_time: 0.2,
    lower_time: 0.12,
    spread: (hip: 0.0, hip_moving: 0.0, air: 0.0, ads: 0.0),
    ads_fov_scale: 0.75,
    ads_move_scale: 1.0,
    move_scale: 1.0,
    recoil: (
        pattern: [(0.0, 0.0)],
        jitter: (0.0, 0.0),
        ads_scale: 0.0,
        recovery_delay: 0.0,
        recovery_rate: 10.0,
    ),
    beam: true,
    // Hands on the model: GripRight and GripLeft in laser_view.tscn.
    grips: Some((right: (0, -0.135, 0.05), left: (0, -0.13, -0.15), rake: 15)),
    // Finger poses fitted to the model by tests/bake_hand_poses.gd:
    // curl in degrees per joint (index, middle, ring, little, thumb), each
    // finger's spread, and the hand's seat off its marker (m). Re-run it
    // after moving the grips or changing the model.
    hands: Some((
        right: (fingers: ((3.5, 58, 51.5), (35, 39, 64.5), (66.5, 71.5, 43), (67.5, 74, 43.5), (-13.5, 4.5, 52.5)), spread: Some((2, 0, 3, 6.5, 20)), seat: (0.002, 0.012, -0.012)),
        index_off: (3.5, 6, 4),
        left: (fingers: ((36, 34.5, 21), (41.5, 42, 25), (69.5, 70, 41.5), (65, 65, 38), (14, 35, 39.5)), spread: Some((-6, -1, 3.5, 9, 38)), seat: (-0.002, -0.004, 0)),
    )),
)
