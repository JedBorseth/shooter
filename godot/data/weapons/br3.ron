// BR-3 bullpup: a three-round burst. One whole burst kills inside about 6 m
// (34 damage a round); past that it takes a fourth round, so a second burst. A
// short pause after each burst keeps it from out-firing the automatics.
(
    name: "BR-3",
    slot: Primary,
    fire_mode: Burst(rounds: 3, delay: 0.16),
    rounds_per_minute: 800,
    magazine: 30,
    reserve: 120,
    damage: (near: 34, far: 25, falloff_start: 4, falloff_end: 40, headshot: 1.4),
    range: 400,
    penetration: 0.32,
    reload: Magazine(time: 2.3, empty_time: 2.8, mag_in: Some(1.5)),
    ads_time: 0.25,
    sprint_out_time: 0.23,
    raise_time: 0.42,
    // First raise: Black Ops 2's for the class, scaled to our quicker draws.
    first_raise_time: 1.1,
    lower_time: 0.28,
    spread: (hip: 2.4, hip_moving: 4.2, air: 6.0, ads: 0.0, bloom: 0.3, bloom_max: 1.8, ads_sway: 0.12),
    ads_fov_scale: 0.78,
    ads_move_scale: 0.6,
    move_scale: 0.98,
    recoil: (
        pattern: [
            (0.36, 0.04), (0.45, -0.11), (0.53, 0.14), (0.45, 0.06),
        ],
        jitter: (0.04, 0.1),
        ads_scale: 0.7,
        kick_return: 0.45,
        recovery_delay: 0.02,
        recovery_rate: 20.0,
    ),
    tracer_every: 3,
    attachments: [Acog, Suppressor, Grip, ExtendedMag],
    // Hands on the model: GripRight and GripLeft in br3_view.tscn.
    grips: Some((right: (0, -0.1275, 0.2244), left: (0, -0.0867, -0.1632), rake: 18)),
    // Finger poses fitted to the model by tests/bake_hand_poses.gd:
    // curl in degrees per joint (index, middle, ring, little, thumb), each
    // finger's spread, and the hand's seat off its marker (m). Re-run it
    // after moving the grips or changing the model.
    hands: Some((
        right: (fingers: ((-3.5, 11, 51.5), (17, 18, 64.5), (20, 17, 64.5), (61, 63.5, 39.5), (-6.5, 7, 5)), spread: Some((-4, -1, 3, 7, 32)), seat: (0.005, 0.005, -0.001)),
        index_off: (-3, 6, 4),
        left: (fingers: ((54.5, 57.5, 33.5), (51.5, 55.5, 33.5), (57.5, 60.5, 53.5), (65, 65, 38), (8, 26.5, 39.5)), spread: Some((-6, -1, 4, 9, 38)), seat: (-0.006, -0.011, 0)),
        left_foregrip: Some((fingers: ((67, 72.5, 43), (60.5, 64, 39), (54.5, 59.5, 40.5), (85, 85, 45), (16, 38.5, 65.5)), spread: Some((-2, 0, 2, 4, 40)), seat: (-0.012, -0.012, -0.012))),
    )),
)
