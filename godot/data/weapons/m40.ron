// M40 bolt-action sniper rifle: one-shot kill to the chest at any range, a
// 3.5x scope with sway that hold-breath (Shift while scoped) steadies.
(
    name: "M40",
    slot: Primary,
    fire_mode: Semi,
    rounds_per_minute: 600,
    cycle_time: 1.05,
    magazine: 5,
    reserve: 25,
    damage: (near: 100, far: 100, falloff_start: 100, falloff_end: 200, headshot: 1.5),
    range: 600,
    reload: Magazine(time: 3.0, empty_time: 3.6),
    ads_time: 0.38,
    sprint_out_time: 0.35,
    raise_time: 0.6,
    lower_time: 0.4,
    spread: (hip: 6.0, hip_moving: 8.0, air: 10.0, ads: 0.0),
    ads_fov_scale: 0.28,
    ads_move_scale: 0.4,
    move_scale: 0.92,
    recoil: (
        pattern: [(2.3, 0.26)],
        jitter: (0.33, 0.4),
        ads_scale: 0.75,
        recovery_delay: 0.12,
        recovery_rate: 7.0,
    ),
    scope: Some((sway: 0.55, hold_breath: 4.0, breath_recovery: 2.5)),
    tracer_every: 1,
)
