// M40 bolt-action sniper rifle: one shot kills to the head or chest at any
// range; a hit lower down or on a limb needs a second. A 4x scope (0.28 of a
// 70 degree view) with sway that hold-breath (Shift while scoped) steadies.
(
    name: "M40",
    class: Sniper,
    slot: Primary,
    fire_mode: Semi,
    rounds_per_minute: 600,
    cycle_time: 1.05,
    magazine: 5,
    reserve: 25,
    damage: (near: 100, far: 100, falloff_start: 100, falloff_end: 200, headshot: 1.5),
    zones: (stomach: 0.9, arm: 0.75, leg: 0.7),
    range: 600,
    penetration: 0.6,
    reload: Magazine(time: 3.0, empty_time: 3.6, mag_in: Some(1.95)),
    ads_time: 0.42,
    sprint_out_time: 0.36,
    raise_time: 0.6,
    // First raise: Black Ops 2's for the class, scaled to our quicker draws.
    first_raise_time: 1.4,
    lower_time: 0.38,
    spread: (hip: 6.0, hip_moving: 8.0, air: 10.0, ads: 0.0),
    ads_fov_scale: 0.28,
    ads_move_scale: 0.4,
    move_scale: 0.92,
    recoil: (
        pattern: [(2.3, 0.26)],
        jitter: (0.33, 0.4),
        ads_scale: 0.75,
        kick_return: 0.7,
        recovery_delay: 0.05,
        recovery_rate: 8.0,
    ),
    scope: Some((sway: 0.55, hold_breath: 4.0, breath_recovery: 2.5)),
    tracer_every: 1,
    attachments: [Suppressor, ExtendedMag],
    // The player level that unlocks it (Create-a-Class, docs/create-a-class.md).
    unlock_level: 22,
    // Hands on the model: GripRight and GripLeft in m40_view.tscn.
    grips: Some((right: (0, -0.13, 0.05), left: (0, -0.08, -0.36), rake: 38, section: Some((centre: (-0.0001, -0.0665), half: (0.0216, 0.0178))))),
    // Finger poses fitted to the model by tests/bake_hand_poses.gd:
    // curl in degrees per joint (index, middle, ring, little, thumb), each
    // finger's spread, and the hand's seat off its marker (m). Re-run it
    // after moving the grips or changing the model.
    hands: Some((
        right: (fingers: ((15, 19.5, 51.5), (60, 63.5, 39), (57.5, 60.5, 36.5), (62.5, 65, 64.5), (-2.5, 11, 9)), spread: Some((-5.5, -2, 3, 7, 32)), seat: (0.012, 0.012, 0.011)),
        index_off: (4, 6, 4),
        left: (fingers: ((30.5, 80, 51.5), (64.5, 69, 40), (67, 69.5, 55.5), (81.5, 92.5, 55.5), (13.5, 32.5, 39.5)), spread: Some((-6, -3.5, 4, 9, 60)), seat: (0, 0, 0)),
    )),
)
