// PDW-9 submachine gun: very fast fire, low damage that falls off early,
// tight hip fire, and quick handling for close quarters.
(
    name: "PDW-9",
    slot: Primary,
    fire_mode: Auto,
    rounds_per_minute: 900,
    magazine: 32,
    reserve: 128,
    damage: (near: 25, far: 14, falloff_start: 10, falloff_end: 25, headshot: 1.3),
    // Limb hits count nearly in full: close-quarters spray is forgiving.
    zones: (stomach: 1.0, arm: 1.0, leg: 0.95),
    range: 200,
    penetration: 0.16,
    reload: Magazine(time: 1.9, empty_time: 2.3, mag_in: Some(1.1)),
    ads_time: 0.19,
    sprint_out_time: 0.16,
    raise_time: 0.34,
    lower_time: 0.24,
    spread: (hip: 1.6, hip_moving: 2.8, air: 5.0, ads: 0.0, bloom: 0.15, bloom_max: 1.2, ads_sway: 0.05),
    ads_fov_scale: 0.85,
    ads_move_scale: 0.7,
    move_scale: 1.05,
    recoil: (
        pattern: [
            (0.23, 0.03), (0.21, -0.07), (0.2, 0.08), (0.18, -0.08),
            (0.18, 0.07), (0.17, -0.05), (0.16, 0.05), (0.16, 0.0),
        ],
        jitter: (0.05, 0.08),
        ads_scale: 0.75,
        kick_return: 0.3,
        recovery_delay: 0.0,
        recovery_rate: 16.0,
    ),
    tracer_every: 3,
    attachments: [Acog, Suppressor, Grip, ExtendedMag],
)
