// PDW-9 submachine gun: very fast fire, low damage that falls off early,
// tight hip fire, and quick handling for close quarters.
(
    name: "PDW-9",
    slot: Primary,
    fire_mode: Auto,
    rounds_per_minute: 900,
    magazine: 32,
    reserve: 128,
    damage: (near: 25, far: 14, falloff_start: 10, falloff_end: 25, headshot: 1.3),
    range: 200,
    reload: Magazine(time: 1.9, empty_time: 2.3),
    ads_time: 0.18,
    sprint_out_time: 0.15,
    raise_time: 0.35,
    lower_time: 0.25,
    spread: (hip: 1.6, hip_moving: 2.8, air: 5.0, ads: 0.25),
    ads_fov_scale: 0.85,
    ads_move_scale: 0.7,
    move_scale: 1.05,
    recoil: (
        pattern: [
            (0.35, 0.05), (0.32, -0.1), (0.3, 0.12), (0.28, -0.12),
            (0.27, 0.1), (0.26, -0.08), (0.25, 0.08), (0.25, 0.0),
        ],
        jitter: (0.08, 0.12),
        ads_scale: 0.8,
        recovery_delay: 0.08,
        recovery_rate: 9.0,
    ),
    tracer_every: 3,
)
