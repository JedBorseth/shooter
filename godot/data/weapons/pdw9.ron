// PDW-9 submachine gun: very fast fire, low damage that falls off early,
// tight hip fire, and quick handling for close quarters.
(
    name: "PDW-9",
    class: Smg,
    slot: Primary,
    fire_mode: Auto,
    rounds_per_minute: 1000,
    magazine: 32,
    reserve: 128,
    damage: (near: 25, far: 14, falloff_start: 15, falloff_end: 30, headshot: 1.3),
    // Limb hits count nearly in full: close-quarters spray is forgiving.
    zones: (stomach: 1.0, arm: 1.0, leg: 0.95),
    range: 200,
    penetration: 0.16,
    reload: Magazine(time: 1.9, empty_time: 2.3, mag_in: Some(1.25)),
    ads_time: 0.19,
    sprint_out_time: 0.16,
    raise_time: 0.34,
    // First raise: Black Ops 2's for the class, scaled to our quicker draws.
    first_raise_time: 0.8,
    lower_time: 0.24,
    spread: (hip: 1.6, hip_moving: 2.8, air: 5.0, ads: 0.0, bloom: 0.15, bloom_max: 1.2, ads_sway: 0.12),
    ads_fov_scale: 0.85,
    ads_move_scale: 0.7,
    move_scale: 1.05,
    recoil: (
        pattern: [
            (0.16, 0.02), (0.18, -0.07), (0.19, 0.08), (0.19, -0.08),
            (0.19, 0.09), (0.18, -0.07), (0.18, 0.08), (0.18, 0.03),
        ],
        jitter: (0.05, 0.12),
        ads_scale: 0.75,
        kick_return: 0.45,
        recovery_delay: 0.02,
        recovery_rate: 20.0,
    ),
    tracer_every: 3,
    attachments: [Acog, Suppressor, Grip, ExtendedMag],
    // The player level that unlocks it (Create-a-Class, docs/create-a-class.md).
    unlock_level: 1,
    // Hands on the model: GripRight and GripLeft in pdw9_view.tscn.
    grips: Some((right: (0, -0.1968, 0.1233), left: (0, -0.1086, -0.1659), rake: 22, section: Some((centre: (0.0000, -0.0909), half: (0.0237, 0.0145))))),
    // Finger poses fitted to the model by tests/bake_hand_poses.gd:
    // curl in degrees per joint (index, middle, ring, little, thumb), each
    // finger's spread, and the hand's seat off its marker (m). Re-run it
    // after moving the grips or changing the model.
    hands: Some((
        right: (fingers: ((13.5, 20, 51.5), (59, 64.5, 57.5), (58.5, 64.5, 47), (43, 75.5, 48.5), (-8.5, 4.5, 5)), spread: Some((-5, 0, 3, 7, 34)), seat: (0.003, 0.003, 0.005)),
        index_off: (4, 6, 4),
        left: (fingers: ((47.5, 62, 37), (61.5, 65, 40.5), (70, 69.5, 55.5), (78.5, 92.5, 55.5), (15.5, 35, 39.5)), spread: Some((-6, -2, 4, 9, 60)), seat: (0, 0, 0)),
        left_foregrip: Some((fingers: ((38.5, 40, 23), (73, 81.5, 64.5), (80, 85, 45), (85, 85, 45), (21.5, 42.5, 65.5)), spread: Some((-2, 0, 2, 4, 40)), seat: (0.012, 0.009, -0.009))),
    )),
)
