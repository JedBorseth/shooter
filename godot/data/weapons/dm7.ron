// DM-7 marksman rifle: semi-automatic, two hits to the chest at any range
// and never one (a headshot kills to about 39 m), a low-power scope with a
// little sway, and a sniper's slow handling scaled down. Black Ops 2's
// SVU-AS: 70 damage (two to kill, a headshot at 1.5x one), about 415 rpm,
// the lowest kick of its class.
(
    name: "DM-7",
    class: Marksman,
    slot: Primary,
    fire_mode: Semi,
    rounds_per_minute: 300,
    magazine: 10,
    reserve: 50,
    damage: (near: 70, far: 55, falloff_start: 30, falloff_end: 70, headshot: 1.5),
    // Limbs take a third hit only far out; the stomach counts as the chest.
    zones: (stomach: 1.0, arm: 0.8, leg: 0.75),
    range: 600,
    penetration: 0.55,
    reload: Magazine(time: 2.6, empty_time: 3.1, mag_in: Some(1.7)),
    ads_time: 0.34,
    sprint_out_time: 0.3,
    raise_time: 0.5,
    // First raise: Black Ops 2's for the class, scaled to our quicker draws.
    first_raise_time: 1.3,
    lower_time: 0.32,
    spread: (hip: 4.5, hip_moving: 6.5, air: 9.0, ads: 0.0, bloom: 0.6, bloom_max: 2.0, ads_sway: 0.13),
    // A 2.5x scope: 0.45 of a 70 degree view.
    ads_fov_scale: 0.45,
    ads_move_scale: 0.5,
    move_scale: 0.95,
    recoil: (
        pattern: [(1.25, 0.12)],
        jitter: (0.2, 0.25),
        ads_scale: 0.8,
        kick_return: 0.62,
        recovery_delay: 0.04,
        recovery_rate: 14.0,
    ),
    scope: Some((sway: 0.3, hold_breath: 4.0, breath_recovery: 2.5)),
    tracer_every: 0,
    attachments: [Suppressor, Grip, ExtendedMag],
    // The player level that unlocks it (Create-a-Class, docs/create-a-class.md).
    unlock_level: 37,
    // Hands on the model: GripRight and GripLeft in dm7_view.tscn.
    grips: Some((right: (0, -0.1316, 0.1067), left: (0, -0.0908, -0.3009), rake: 32, section: Some((centre: (0.0001, -0.0798), half: (0.0242, 0.0238))))),
    // Finger poses fitted to the model by tests/bake_hand_poses.gd:
    // curl in degrees per joint (index, middle, ring, little, thumb), each
    // finger's spread, and the hand's seat off its marker (m). Re-run it
    // after moving the grips or changing the model.
    hands: Some((
        right: (fingers: ((9.5, 18, 51.5), (39, 63.5, 51.5), (40.5, 62.5, 41), (56, 69, 43.5), (-7.5, 4.5, 5.5)), spread: Some((-4, 0, 3, 7.5, 32)), seat: (0.006, 0.006, 0)),
        index_off: (4, 6, 4),
        left: (fingers: ((12, 73, 42), (56, 57.5, 34), (62, 61.5, 36), (69.5, 70.5, 55.5), (16, 37, 28)), spread: Some((-6, -2, 3, 9, 60)), seat: (0.002, -0.002, 0)),
        left_foregrip: Some((fingers: ((38.5, 40.5, 23), (73.5, 80, 64.5), (80, 85, 45), (85, 85, 45), (21.5, 45.5, 65.5)), spread: Some((-2, 0, 2, 4, 40)), seat: (0.012, 0.01, -0.011))),
    )),
)
