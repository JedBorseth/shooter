// RL-4 rocket launcher: a sidearm-slot shoulder tube with one rocket loaded
// and two spare. The rocket flies straight at 65 m/s, sagging slowly, and
// goes off on whatever it meets (a player it passes, the map) or after 4 s
// in the air: 200 damage within 1.5 m, falling to 30 at 6 m, a kill within
// about 4.1 m (`equipment::rocket_damage`). Slow to aim and reload, and the
// carrier moves at 90%. Black Ops 2's RPG: free-firing, a kill near the
// blast, one hit downs any aircraft, 90% movement.
(
    name: "RL-4",
    class: Launcher,
    slot: Secondary,
    fire_mode: Semi,
    rounds_per_minute: 60,
    rocket: true,
    magazine: 1,
    reserve: 2,
    // Unused: the rocket's blast does the damage.
    damage: (near: 200, far: 200, falloff_start: 100, falloff_end: 200, headshot: 1.0),
    range: 260,
    reload: Magazine(time: 3.2, empty_time: 3.2, mag_in: Some(2.2)),
    ads_time: 0.45,
    sprint_out_time: 0.38,
    raise_time: 0.6,
    // First raise: Black Ops 2's for the class, scaled to our quicker draws.
    first_raise_time: 1.3,
    lower_time: 0.4,
    spread: (hip: 3.0, hip_moving: 5.0, air: 8.0, ads: 0.0, ads_sway: 0.18),
    ads_fov_scale: 0.75,
    ads_move_scale: 0.5,
    move_scale: 0.9,
    recoil: (
        pattern: [(2.5, 0.2)],
        jitter: (0.3, 0.4),
        ads_scale: 0.8,
        kick_return: 0.7,
        recovery_delay: 0.05,
        recovery_rate: 10.0,
    ),
    tracer_every: 0,
    // The player level that unlocks it (Create-a-Class, docs/create-a-class.md).
    unlock_level: 19,
    // Hands on the model: GripRight and GripLeft in rl4_view.tscn.
    grips: Some((right: (0, -0.155, -0.06), left: (0, -0.1, -0.25), rake: 18, section: Some((centre: (0.0000, -0.0851), half: (0.0340, 0.0189))))),
    // Finger poses fitted to the model by tests/bake_hand_poses.gd:
    // curl in degrees per joint (index, middle, ring, little, thumb), each
    // finger's spread, and the hand's seat off its marker (m). Re-run it
    // after moving the grips or changing the model.
    hands: Some((
        right: (fingers: ((7, 10.5, 51.5), (50.5, 74.5, 51.5), (39, 75.5, 45.5), (7, 83, 51), (4, 4.5, 6)), spread: Some((-4, 0, 3, 13, 43)), seat: (0, -0.001, 0.011)),
        index_off: (4, 6, 4),
        left: (fingers: ((7.5, 47.5, 42), (47, 47.5, 40), (53, 54, 31.5), (60.5, 58.5, 34.5), (16, 35, 27.5)), spread: Some((-6, -1, 4, 7.5, 60)), seat: (0, -0.004, 0)),
    )),
)
