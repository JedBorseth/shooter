// M4A1-style carbine: 4-shot kill up close (30 damage), 5 at range.
// Angles are degrees, times seconds, distances metres. See rust/sim/src/weapon/def.rs.
(
    name: "M4A1",
    slot: Primary,
    fire_mode: Auto,
    rounds_per_minute: 750,
    magazine: 30,
    reserve: 120,
    damage: (near: 30, far: 21, falloff_start: 25, falloff_end: 50, headshot: 1.4),
    range: 400,
    penetration: 0.3,
    reload: Magazine(time: 2.1, empty_time: 2.6, mag_in: Some(1.35)),
    ads_time: 0.24,
    sprint_out_time: 0.22,
    raise_time: 0.42,
    // First raise: Black Ops 2's for the class, scaled to our quicker draws.
    first_raise_time: 1.1,
    lower_time: 0.28,
    spread: (hip: 2.2, hip_moving: 4.0, air: 6.0, ads: 0.0, bloom: 0.25, bloom_max: 2.0, ads_sway: 0.12),
    ads_fov_scale: 0.8,
    ads_move_scale: 0.6,
    move_scale: 1.0,
    recoil: (
        pattern: [
            (0.3, 0.03), (0.33, 0.06), (0.35, 0.1), (0.36, 0.12),
            (0.38, 0.07), (0.38, 0.03), (0.38, -0.07), (0.36, -0.15),
            (0.36, -0.1), (0.35, 0.05), (0.35, 0.12), (0.35, 0.09),
        ],
        jitter: (0.04, 0.12),
        ads_scale: 0.7,
        kick_return: 0.45,
        recovery_delay: 0.02,
        recovery_rate: 20.0,
    ),
    tracer_every: 3,
    attachments: [RedDot, Acog, Suppressor, Grip, ExtendedMag],
    // Hands on the model: GripRight and GripLeft in m4_view.tscn.
    grips: Some((right: (0, -0.1196, -0.0075), left: (0, -0.0741, -0.2619), rake: 22, section: Some((centre: (-0.0001, -0.0623), half: (0.0205, 0.0159))))),
    // Finger poses fitted to the model by tests/bake_hand_poses.gd:
    // curl in degrees per joint (index, middle, ring, little, thumb), each
    // finger's spread, and the hand's seat off its marker (m). Re-run it
    // after moving the grips or changing the model.
    hands: Some((
        right: (fingers: ((14, 19, 51.5), (13.5, 13.5, 64.5), (10.5, 12.5, 13), (61, 66, 39.5), (-8.5, 4.5, 4.5)), spread: Some((-4, 0, 3, 7, 32)), seat: (0.012, -0.011, 0.007)),
        index_off: (4, 6, 4),
        left: (fingers: ((10, 64, 36.5), (-2, 61.5, 36.5), (39, 41.5, 55.5), (65, 65, 38), (0, 16.5, 14)), spread: Some((-6, 2.5, 4, 9, 38)), seat: (0, -0.007, 0)),
        left_foregrip: Some((fingers: ((38.5, 40, 23.5), (73, 81.5, 64.5), (80, 85, 45), (85, 85, 45), (21.5, 43.5, 65.5)), spread: Some((-2, 0, 2, 4, 40)), seat: (0.012, 0.011, -0.009))),
    )),
)
