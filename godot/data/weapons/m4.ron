// M4A1-style carbine: 4-shot kill up close (30 damage), 5 at range.
// Angles are degrees, times seconds, distances metres. See rust/sim/src/weapon/def.rs.
(
    name: "M4A1",
    slot: Primary,
    fire_mode: Auto,
    rounds_per_minute: 750,
    magazine: 30,
    reserve: 120,
    damage: (near: 30, far: 21, falloff_start: 25, falloff_end: 50, headshot: 1.4),
    range: 400,
    penetration: 0.3,
    reload: Magazine(time: 2.1, empty_time: 2.6, mag_in: Some(1.35)),
    ads_time: 0.24,
    sprint_out_time: 0.22,
    raise_time: 0.42,
    lower_time: 0.28,
    spread: (hip: 2.2, hip_moving: 4.0, air: 6.0, ads: 0.0, bloom: 0.25, bloom_max: 2.0, ads_sway: 0.12),
    ads_fov_scale: 0.8,
    ads_move_scale: 0.6,
    move_scale: 1.0,
    recoil: (
        pattern: [
            (0.3, 0.03), (0.33, 0.06), (0.35, 0.1), (0.36, 0.12),
            (0.38, 0.07), (0.38, 0.03), (0.38, -0.07), (0.36, -0.15),
            (0.36, -0.1), (0.35, 0.05), (0.35, 0.12), (0.35, 0.09),
        ],
        jitter: (0.04, 0.12),
        ads_scale: 0.7,
        kick_return: 0.45,
        recovery_delay: 0.02,
        recovery_rate: 20.0,
    ),
    tracer_every: 3,
    attachments: [RedDot, Acog, Suppressor, Grip, ExtendedMag],
)
