// M870 pump shotgun: 10 pellets, one shot kills to about 9 m and two to
// about 12 m; loads shell by shell.
// Firing (with a shell loaded) interrupts a reload.
(
    name: "M870",
    slot: Primary,
    fire_mode: Semi,
    rounds_per_minute: 600,
    cycle_time: 0.55,
    pellets: 10,
    pellet_spread: 2.0,
    magazine: 6,
    reserve: 30,
    damage: (near: 18, far: 10, falloff_start: 10, falloff_end: 30, headshot: 1.2),
    range: 60,
    penetration: 0.08,
    reload: PerRound(start: 0.45, per_round: 0.5, end: 0.45),
    ads_time: 0.24,
    sprint_out_time: 0.21,
    raise_time: 0.45,
    // First raise: Black Ops 2's for the class, scaled to our quicker draws.
    first_raise_time: 1.35,
    lower_time: 0.3,
    spread: (hip: 1.0, hip_moving: 1.5, air: 3.0, ads: 0.0, ads_sway: 0.13),
    ads_fov_scale: 0.88,
    ads_move_scale: 0.65,
    move_scale: 0.97,
    recoil: (
        pattern: [(2.1, 0.2)],
        jitter: (0.26, 0.33),
        ads_scale: 0.8,
        kick_return: 0.65,
        recovery_delay: 0.04,
        recovery_rate: 16.0,
    ),
    tracer_every: 0,
    attachments: [Suppressor, Grip, ExtendedMag],
    // Hands on the model: GripRight and GripLeft in m870_view.tscn.
    grips: Some((right: (0, -0.1147, 0.1601), left: (0, -0.0658, -0.2752), rake: 45, section: Some((centre: (0.0000, -0.0505), half: (0.0229, 0.0194))))),
    // Finger poses fitted to the model by tests/bake_hand_poses.gd:
    // curl in degrees per joint (index, middle, ring, little, thumb), each
    // finger's spread, and the hand's seat off its marker (m). Re-run it
    // after moving the grips or changing the model.
    hands: Some((
        right: (fingers: ((57.5, 78.5, 44), (70, 80, 45), (75, 80, 45), (80, 80, 45), (-18.5, 4.5, 52.5)), spread: Some((-5, 0, 3, 7, 40.5)), seat: (0, -0.011, -0.012)),
        index_off: (4, 6, 4),
        left: (fingers: ((-5, 64, 47), (1.5, 61.5, 43), (50, 74.5, 56), (50, 88, 55), (4, 19.5, 15)), spread: Some((-13, 5.5, 2, 4, 45)), seat: (0, -0.002, 0)),
        left_foregrip: Some((fingers: ((38.5, 40, 23.5), (73, 81.5, 64.5), (80, 85, 45), (85, 85, 45), (21.5, 43, 65.5)), spread: Some((-2, 0, 2, 4, 40)), seat: (0.012, 0.01, -0.009))),
    )),
)
