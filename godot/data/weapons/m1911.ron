// M1911-style sidearm: semi-automatic, fast handling.
(
    name: "M1911",
    slot: Secondary,
    fire_mode: Semi,
    rounds_per_minute: 400,
    magazine: 8,
    reserve: 32,
    damage: (near: 40, far: 25, falloff_start: 10, falloff_end: 30, headshot: 1.4),
    range: 200,
    penetration: 0.12,
    reload: Magazine(time: 1.5, empty_time: 1.9, mag_in: Some(0.95)),
    ads_time: 0.16,
    sprint_out_time: 0.12,
    raise_time: 0.3,
    // First raise: Black Ops 2's for the class, scaled to our quicker draws.
    first_raise_time: 0.8,
    lower_time: 0.2,
    spread: (hip: 2.0, hip_moving: 3.0, air: 5.0, ads: 0.1, bloom: 0.4, bloom_max: 1.5, ads_sway: 0.14),
    ads_fov_scale: 0.9,
    ads_move_scale: 0.75,
    move_scale: 1.05,
    recoil: (
        pattern: [(0.95, 0.07)],
        jitter: (0.15, 0.22),
        ads_scale: 0.75,
        kick_return: 0.6,
        recovery_delay: 0.03,
        recovery_rate: 14.0,
    ),
    tracer_every: 0,
    // Hands on the model: GripRight and GripLeft in pistol_view.tscn.
    grips: Some((right: (0, -0.0833, 0.0098), left: (0, -0.102, 0.0217), rake: 0)),
    // Finger poses fitted to the model by tests/bake_hand_poses.gd:
    // curl in degrees per joint (index, middle, ring, little, thumb), each
    // finger's spread, and the hand's seat off its marker (m). Re-run it
    // after moving the grips or changing the model.
    hands: Some((
        right: (fingers: ((7, 15, 68), (15, 12, 64.5), (52, 54.5, 64.5), (51, 67.5, 54.5), (-6.5, 5.5, 4)), spread: Some((-4, 0, 3, 7, 32)), seat: (0.004, -0.007, 0.004)),
        index_off: (4, 6, 4),
        left: (fingers: ((31.5, 30, 58), (56.5, 59.5, 34.5), (63.5, 66, 39.5), (92, 99, 60.5), (16, 30.5, 18)), spread: Some((2, 1.5, 5, 6, 45)), seat: (-0.002, -0.004, 0.002)),
    )),
)
