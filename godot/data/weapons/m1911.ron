// M1911-style sidearm: semi-automatic, fast handling.
(
    name: "M1911",
    slot: Secondary,
    fire_mode: Semi,
    rounds_per_minute: 400,
    magazine: 8,
    reserve: 32,
    damage: (near: 40, far: 25, falloff_start: 10, falloff_end: 30, headshot: 1.4),
    range: 200,
    penetration: 0.12,
    reload: Magazine(time: 1.5, empty_time: 1.9),
    ads_time: 0.15,
    sprint_out_time: 0.1,
    raise_time: 0.25,
    lower_time: 0.18,
    spread: (hip: 2.0, hip_moving: 3.0, air: 5.0, ads: 0.1),
    ads_fov_scale: 0.9,
    ads_move_scale: 0.75,
    move_scale: 1.05,
    recoil: (
        pattern: [(0.95, 0.07)],
        jitter: (0.15, 0.22),
        ads_scale: 0.75,
        recovery_delay: 0.05,
        recovery_rate: 12.0,
    ),
    tracer_every: 0,
)
