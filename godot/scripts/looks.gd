extends RefCounted
## The graded picture of each map: exposure, bloom, haze, and a colour grade.
##
## `GraphicsQuality.adopt` calls `apply` for every map's Environment as it
## loads. A map listed in `MAPS` gets its environment overrides and a colour
## look-up table built from its grade; the table runs inside the tonemap pass
## the renderer already does, so a grade costs nothing per frame. A map that is
## not listed keeps the look authored in its scene.
##
## The values live here, not in each scene's Environment, so a map that is
## regenerated by a tool keeps its grade.

## Edge length of the colour look-up table. 32 gives smooth gradients.
const LUT_SIZE := 32

## Per-map looks, keyed by scene path.
##   env    Environment properties to set.
##   grade  The colour grade, applied to the tonemapped picture:
##     contrast   S-curve strength around `pivot` (1 = none).
##     pivot      The brightness that contrast leaves alone.
##     saturation Overall colour strength (1 = unchanged).
##     shadows    Tint multiplied into the dark end.
##     highlights Tint multiplied into the bright end.
##     balance    Where the two tints cross, as a brightness.
##     toe        Deepens the darkest shadows by up to this fraction, without
##                clipping them (0 = none).
##   flare  How strongly the sun flares in the lens when it is in view and not
##          hidden (scripts/lens.gd); 0 or missing for none. The cover test
##          casts rays against the world's collision, so set it only on maps
##          whose scenery around the sun collides.
##   wetness  How wet the map's surfaces are, 0 dry to 1 soaked; from 0.5 up,
##            puddles collect on the ground (shaders/world.gdshader).
##   sun    DirectionalLight3D properties to set on the map's sun (its strength
##          against the sky light sets how hard the daylight is).
##   exposure  How far eye adaptation may move the exposure, in stops
##             (scripts/eye_adaptation.gd); missing for none:
##     reference The light level the map was graded at, as the eye's probe
##               measures it (EyeAdaptation.light_level, typical of the
##               benchmark views): exposure is unchanged there.
##     brighter How far a darker spot (an alley, a tunnel) may open up.
##     darker   How far a brighter spot, or looking into the sun, closes down.
##
## Every listed map also gets the shared bloom in `BLOOM` (unless its `env`
## says otherwise) and lens dirt on that bloom (scripts/lens_dirt.gd).
const MAPS := {
	"res://scenes/main.tscn":
	{
		"env":
		# Ambient occlusion also darkens direct light a little, which
		{
			# grounds props and characters in the sun.
			"ssao_light_affect": 0.15,
			# Haze: the far wall fades toward the sky instead of meeting it at
			# a hard line, and the air glows a little toward the sun.
			"fog_sun_scatter": 0.15,
			"fog_density": 0.0024,
			"fog_aerial_perspective": 0.85,
			"fog_sky_affect": 0.3,
			# Tight, dark ambient occlusion where things meet the ground: a
			# short radius with a strong detail pass draws a crisp contact line
			# under walls, blocks, and boots instead of a wide grey halo, and
			# a higher power keeps open ground clean.
			"ssao_radius": 0.5,
			"ssao_intensity": 2.8,
			"ssao_power": 1.9,
			"ssao_detail": 2.0,
			# Hard daylight: a filmic curve with a real toe and shoulder, a
			# stronger sun against the sky light (baked light stays as it
			# was), and less exposure, so sunlit sand and concrete reach near
			# white while shade goes properly dark.
			"tonemap_mode": Environment.TONE_MAPPER_ACES,
			"tonemap_white": 8.0,
			"tonemap_exposure": 0.82,
			# More sky light for what the lightmap does not light (soldiers,
			# the first-person weapon), so they keep their fill in the shade.
			"ambient_light_energy": 1.35,
			# The grade below replaces these.
			"adjustment_contrast": 1.0,
			"adjustment_saturation": 1.0,
		},
		"sun": {"light_energy": 2.9},
		"exposure": {"reference": 1.0, "darker": 0.5, "brighter": 0.8},
		"grade":
		{
			"contrast": 1.3,
			"pivot": 0.45,
			"saturation": 1.08,
			"shadows": Color(0.94, 0.98, 1.06),
			"highlights": Color(1.04, 1.0, 0.95),
			"balance": 0.5,
			"toe": 0.12,
		},
		"flare": 1.0,
	},
}

## Bloom for every listed map: only what is brighter than white blooms (no
## veil over the whole picture), it adds light the way a lens does rather than
## screening it, and a faint wide level gives the sun and lamps a soft halo.
## The two widest levels are tiny textures, so they cost almost nothing.
const BLOOM := {
	"glow_blend_mode": Environment.GLOW_BLEND_MODE_ADDITIVE,
	"glow_bloom": 0.0,
	"glow_intensity": 0.45,
	"glow_hdr_threshold": 1.0,
	"glow_hdr_scale": 2.0,
	"glow_hdr_luminance_cap": 16.0,
	"glow_levels/1": 0.0,
	"glow_levels/2": 0.35,
	"glow_levels/3": 0.6,
	"glow_levels/4": 0.5,
	"glow_levels/5": 0.35,
	"glow_levels/6": 0.25,
	"glow_levels/7": 0.12,
	# Lens dirt lights up where the bloom passes through it.
	"glow_map_strength": 0.4,
}

const LensDirt := preload("res://scripts/lens_dirt.gd")

## Built look-up tables, by scene path.
static var _luts: Dictionary = {}


## Applies the look of the map `scene_path` to its environment. Returns true if
## the map has one.
static func apply(env: Environment, scene_path: String) -> bool:
	if not MAPS.has(scene_path):
		return false
	var look: Dictionary = MAPS[scene_path]
	for property: String in BLOOM:
		env.set(property, BLOOM[property])
	env.glow_map = LensDirt.texture()
	var overrides: Dictionary = look.get("env", {})
	for property: String in overrides:
		env.set(property, overrides[property])
	if look.has("grade"):
		env.adjustment_enabled = true
		env.adjustment_color_correction = lut_for(scene_path)
	return true


## Sets the look's sun properties on the map's sun. Returns true if it has any.
static func apply_sun(light: DirectionalLight3D, scene_path: String) -> bool:
	var sun: Dictionary = MAPS.get(scene_path, {}).get("sun", {})
	for property: String in sun:
		light.set(property, sun[property])
	return not sun.is_empty()


## How far eye adaptation may move the exposure on the map `scene_path`:
## {"reference", "brighter", "darker"}, or empty for none.
static func adaptation_for(scene_path: String) -> Dictionary:
	var exposure: Dictionary = MAPS.get(scene_path, {}).get("exposure", {})
	if exposure.is_empty():
		return {}
	return {
		"reference": float(exposure.get("reference", 1.0)),
		"brighter": float(exposure.get("brighter", 0.0)),
		"darker": float(exposure.get("darker", 0.0)),
	}


## How wet the map `scene_path` is: 0 for dry.
static func wetness_for(scene_path: String) -> float:
	return float(MAPS.get(scene_path, {}).get("wetness", 0.0))


## How strongly the sun flares on the map `scene_path`: 0 for none.
static func flare_for(scene_path: String) -> float:
	return float(MAPS.get(scene_path, {}).get("flare", 0.0))


## The colour look-up table for a map's grade, built once.
static func lut_for(scene_path: String) -> Texture3D:
	if _luts.has(scene_path):
		return _luts[scene_path]
	var grade: Dictionary = MAPS[scene_path]["grade"]
	var lut := build_lut(grade)
	_luts[scene_path] = lut
	return lut


## Builds a look-up table: the renderer looks up each tonemapped pixel (red
## across, green down, blue through the slices) and shows what it finds.
static func build_lut(grade: Dictionary) -> ImageTexture3D:
	var lut := ImageTexture3D.new()
	lut.create(Image.FORMAT_RGB8, LUT_SIZE, LUT_SIZE, LUT_SIZE, false, lut_slices(grade))
	return lut


## The table's slices along blue, each an image of red across and green down.
static func lut_slices(grade: Dictionary) -> Array[Image]:
	var inputs := PackedFloat32Array()
	for i in LUT_SIZE:
		inputs.append(texel_input(i))
	var slices: Array[Image] = []
	for b in LUT_SIZE:
		var data := PackedByteArray()
		data.resize(LUT_SIZE * LUT_SIZE * 3)
		var at := 0
		for g in LUT_SIZE:
			for r in LUT_SIZE:
				var colour := graded(Color(inputs[r], inputs[g], inputs[b]), grade)
				data[at] = roundi(clampf(colour.r, 0.0, 1.0) * 255.0)
				data[at + 1] = roundi(clampf(colour.g, 0.0, 1.0) * 255.0)
				data[at + 2] = roundi(clampf(colour.b, 0.0, 1.0) * 255.0)
				at += 3
		slices.append(Image.create_from_data(LUT_SIZE, LUT_SIZE, false, Image.FORMAT_RGB8, data))
	return slices


## The input value texel `i` answers for, on each axis. The renderer samples
## the table with the colour as the texture coordinate and no half-texel
## correction, so the centre of texel `i` is the input (i + 0.5) / size: an
## identity table built that way changes a frame by less than one step in 255,
## while one built as i / (size - 1) darkens the shadows by more than 1% of
## full brightness (measured in Godot 4.7.2). The last texel answers for
## exactly 1, so white stays white.
static func texel_input(i: int) -> float:
	if i >= LUT_SIZE - 1:
		return 1.0
	return (i + 0.5) / LUT_SIZE


## One colour through a grade. Colours are display values (after tonemapping),
## which is what the renderer looks up.
static func graded(colour: Color, grade: Dictionary) -> Color:
	var luma := colour.r * 0.2126 + colour.g * 0.7152 + colour.b * 0.0722
	# Contrast on brightness, so hues do not shift: an S-curve through the pivot.
	var contrast: float = grade.get("contrast", 1.0)
	var pivot: float = grade.get("pivot", 0.45)
	var curved := luma
	if luma < pivot:
		curved = pivot * pow(luma / pivot, contrast)
	else:
		curved = 1.0 - (1.0 - pivot) * pow((1.0 - luma) / (1.0 - pivot), contrast)
	# A toe that deepens the darkest quarter of the range. It scales, so
	# shadows keep their detail instead of clipping to black.
	var toe: float = grade.get("toe", 0.0)
	curved *= 1.0 - toe + toe * smoothstep(0.0, 0.25, curved)
	var scale := curved / luma if luma > 0.0001 else 0.0
	var out := Color(colour.r * scale, colour.g * scale, colour.b * scale)
	# Split toning: one tint for the dark end, one for the bright end.
	var balance: float = grade.get("balance", 0.5)
	var bright := smoothstep(balance - 0.35, balance + 0.35, curved)
	var shadows: Color = grade.get("shadows", Color.WHITE)
	var highlights: Color = grade.get("highlights", Color.WHITE)
	var tint := shadows.lerp(highlights, bright)
	# Tints fade out at black and white, so neither end picks up a cast.
	var strength := 4.0 * curved * (1.0 - curved)
	strength = minf(strength * 1.5, 1.0)
	out.r *= lerpf(1.0, tint.r, strength)
	out.g *= lerpf(1.0, tint.g, strength)
	out.b *= lerpf(1.0, tint.b, strength)
	var saturation: float = grade.get("saturation", 1.0)
	var grey := out.r * 0.2126 + out.g * 0.7152 + out.b * 0.0722
	out.r = lerpf(grey, out.r, saturation)
	out.g = lerpf(grey, out.g, saturation)
	out.b = lerpf(grey, out.b, saturation)
	# A bright, saturated colour can land above 1 in one channel. Pull it
	# toward its own grey until it fits, so it keeps its hue instead of
	# clipping to a different one.
	grey = clampf(out.r * 0.2126 + out.g * 0.7152 + out.b * 0.0722, 0.0, 1.0)
	var peak := maxf(out.r, maxf(out.g, out.b))
	if peak > 1.0:
		var fit := (1.0 - grey) / (peak - grey)
		out.r = grey + (out.r - grey) * fit
		out.g = grey + (out.g - grey) * fit
		out.b = grey + (out.b - grey) * fit
	return out
